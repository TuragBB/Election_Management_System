@model NominationSystem.Models.NominationDetail
@using NominationSystem.Models

@{
    Layout = null;
    string pdfName = "Nomination-" + Model.ApplicationNo + ".pdf";
}

@functions {
    private static string YesNo(bool v) { return v ? "হ্যাঁ" : "না"; }
}

<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>মনোনয়ন ফরম - @Model.ApplicationNo</title>
    <link href="@(Url.Content("~/Content/admin-print.css") + "?v=" + System.IO.File.GetLastWriteTime(Server.MapPath("~/Content/admin-print.css")).Ticks)" rel="stylesheet" />
</head>
<body>
    <div class="print-toolbar no-print">
        <button type="button" id="btnPrint" class="pt-btn primary">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6" /><rect x="3" y="9" width="18" height="9" rx="2" /><path d="M6 14h12v7H6z" /></svg>
            প্রিন্ট করুন
        </button>
        <button type="button" id="btnPdf" class="pt-btn">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12" /><path d="M7 11l5 5 5-5" /><path d="M4 21h16" /></svg>
            <span id="pdfLabel">PDF ডাউনলোড</span>
        </button>
        <button type="button" id="btnClose" class="pt-btn">বন্ধ করুন</button>
    </div>

    <div class="paper one-page" id="printArea">
        <div class="form-header has-photo">
            <div class="fh-side"></div>
            <div class="fh-center">
                <div class="fh-org">Staff Welfare Fund</div>
                <h1>নির্বাচনে অংশগ্রহণের আবেদন / মনোনয়ন ফরম</h1>
                <h3>ত্রিবার্ষিক নির্বাচন–২০২৭</h3>
                <div class="fh-meta">
                    <span>আবেদনপত্র নং: <strong>@Model.ApplicationNo</strong></span>
                    <span>তারিখ: <strong>@Bn.ShortDate(Model.ApplicationDate)</strong></span>
                </div>
            </div>
            <div class="fh-photo">
                <span class="fh-photo-ph">ছবি আপলোড<br />করা হয়নি</span>
                <img src="@Url.Action("Photo", "Admin", new { id = Model.NominationId })" alt="প্রার্থীর ছবি"
                     onerror="this.style.display='none';" />
            </div>
        </div>

        <div class="section personal-print-section">
            <h2>ক. প্রার্থীর ব্যক্তিগত তথ্য</h2>
            <div class="personal-two-col">
                <table class="kv">
                    <tr><th>১. প্রার্থীর নাম</th><td>@Model.CandidateName</td></tr>
                    <tr><th>২. সদস্য নং</th><td>@Model.MemberNo</td></tr>
                    <tr><th>৩. সংস্থার আইডি নং</th><td>@Model.OrganizationId</td></tr>
                    <tr><th>৪. সংস্থার পদবী</th><td>@Model.Designation</td></tr>
                    <tr><th>৫. পিতার/স্বামীর নাম</th><td>@Model.FatherOrHusbandName</td></tr>
                    <tr><th>৬. মাতার নাম</th><td>@Model.MotherName</td></tr>
                </table>
                <table class="kv">
                    <tr><th>৭. জন্মতারিখ</th><td>@Bn.ShortDate(Model.DateOfBirth)</td></tr>
                    <tr><th>৮. জাতীয় পরিচয়পত্র নং</th><td>@Model.NID</td></tr>
                    <tr><th>৯. বর্তমান ঠিকানা</th><td>@Model.PresentAddress</td></tr>
                    <tr><th>১০. স্থায়ী ঠিকানা</th><td>@Model.PermanentAddress</td></tr>
                    <tr><th>১১. মোবাইল নম্বর</th><td>@Model.Mobile</td></tr>
                    <tr><th>১২. ই-মেইল</th><td>@(string.IsNullOrWhiteSpace(Model.Email) ? "—" : Model.Email)</td></tr>
                </table>
            </div>
        </div>

        <div class="section">
            <h2>খ. যে পদের জন্য প্রার্থী হতে ইচ্ছুক</h2>
            <table class="kv compact-table">
                <tr><th>নির্বাচিত পদের নাম</th><td><strong>@Bn.PostWithEnglish(Model.DesiredPost)</strong></td></tr>
            </table>
        </div>

        <div class="section">
            <h2>গ. সদস্যপদ সংক্রান্ত তথ্য</h2>
            <table class="kv compact-table membership-print">
                <tr><th>সদস্য হওয়ার তারিখ</th><td>@Bn.ShortDate(Model.MembershipDate)</td></tr>
                <tr><th>সদস্যপদ সক্রিয়</th><td>@YesNo(Model.IsMembershipActive)</td></tr>
                <tr><th>সঞ্চয় হালনাগাদ</th><td>@YesNo(Model.IsSavingsUpdated)</td></tr>
                <tr><th>ঋণ হালনাগাদ</th><td>@YesNo(Model.IsLoanUpdated)</td></tr>
                <tr><th>গঠনতন্ত্র অনুযায়ী যোগ্য</th><td>@YesNo(Model.IsEligible)</td></tr>
            </table>
        </div>

        <div class="section declaration-print-section">
            <h2>ঘ. প্রার্থীর ঘোষণা</h2>
            <ol class="declaration">
                <li>উপরোক্ত সকল তথ্য আমার জ্ঞান ও বিশ্বাস অনুযায়ী সঠিক ও সত্য।</li>
                <li>আমি সমিতির গঠনতন্ত্র, নির্বাচন সংক্রান্ত বিধি এবং নির্বাচন কমিশনের নির্দেশনা মেনে চলব।</li>
                <li>নির্বাচনে অংশগ্রহণের জন্য গঠনতন্ত্রে নির্ধারিত সকল যোগ্যতা আমি পূরণ করি।</li>
                <li>আমার কোনো তথ্য অসত্য, অসম্পূর্ণ বা গোপন প্রমাণিত হলে নির্বাচন কমিশন সমিতি গঠনতন্ত্র অনুযায়ী প্রয়োজনীয় ব্যবস্থা গ্রহণ করতে পারবেন।</li>
                <li>নির্বাচনী আচরণবিধি মেনে চলব এবং কোনো ধরনের অনৈতিক প্রভাব, চাপ, অর্থ বা সুবিধা প্রদানের চেষ্টা করব না।</li>
                <li>নির্বাচনের ফলাফল ও নির্বাচন কমিশনের বৈধ সিদ্ধান্তকে গঠনতন্ত্রের বিধান অনুযায়ী সম্মান করব।</li>
            </ol>
            <p class="accepted">ঘোষণায় সম্মতি: <strong>@(Model.CandidateDeclarationAccepted ? "প্রদান করা হয়েছে" : "প্রদান করা হয়নি")</strong></p>

            <div class="sign-row signature-row-large">
                <div class="sign-box">
                    <div class="sign-space"></div>
                    <strong>প্রার্থীর স্বাক্ষর</strong><br />
                    নাম: @Model.CandidateName<br />
                    তারিখ: ______________
                </div>
                <div class="sign-box">
                    <div class="sign-space"></div>
                    <strong>প্রস্তাবকারীর স্বাক্ষর</strong><br />
                    নাম: @Model.ProposerName<br />
                    সদস্য নং: @Model.ProposerMemberNo
                </div>
            </div>
        </div>

        <div class="section certification-print-section">
            <h2>প্রস্তাবকারী ও সমর্থনকারীর প্রত্যয়ন</h2>
            <div class="two-col">
                <table class="kv">
                    <tr><th colspan="2" class="sub">প্রস্তাবকারী সদস্য</th></tr>
                    <tr><th>নাম</th><td>@Model.ProposerName</td></tr>
                    <tr><th>সদস্য নং</th><td>@Model.ProposerMemberNo</td></tr>
                    <tr><th>মোবাইল</th><td>@Model.ProposerMobile</td></tr>
                    <tr><th>তারিখ</th><td>@Bn.ShortDate(Model.ProposerDate)</td></tr>
                </table>

                <table class="kv">
                    <tr><th colspan="2" class="sub">সমর্থনকারী সদস্য</th></tr>
                    <tr><th>নাম</th><td>@Model.SupporterName</td></tr>
                    <tr><th>সদস্য নং</th><td>@Model.SupporterMemberNo</td></tr>
                    <tr><th>মোবাইল</th><td>@Model.SupporterMobile</td></tr>
                    <tr><th>তারিখ</th><td>@Bn.ShortDate(Model.SupporterDate)</td></tr>
                </table>
            </div>

            <div class="sign-row signature-row-large certification-signatures">
                <div class="sign-box">
                    <div class="sign-space"></div>
                    <strong>প্রস্তাবকারীর স্বাক্ষর</strong>
                </div>
                <div class="sign-box">
                    <div class="sign-space"></div>
                    <strong>সমর্থনকারীর স্বাক্ষর</strong>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        (function () {
            var fileName = @Html.Raw(Json.Encode(pdfName));
            var btnPdf = document.getElementById("btnPdf");
            var label = document.getElementById("pdfLabel");
            var printArea = document.getElementById("printArea");

            document.getElementById("btnPrint").addEventListener("click", function () {
                window.print();
            });

            document.getElementById("btnClose").addEventListener("click", function () {
                window.close();
            });

            btnPdf.addEventListener("click", function () {
                if (typeof html2pdf === "undefined") {
                    alert("PDF লাইব্রেরি লোড হয়নি। প্রিন্ট করুন চেপে Destination হিসেবে Save as PDF নির্বাচন করুন।");
                    return;
                }

                var original = label.textContent;
                btnPdf.disabled = true;
                label.textContent = "PDF তৈরি হচ্ছে...";
                document.body.classList.add("pdf-mode");

                var opt = {
                    margin: [6, 8, 6, 8],
                    filename: fileName,
                    image: { type: "jpeg", quality: 0.98 },
                    html2canvas: {
                        scale: 2,
                        useCORS: true,
                        backgroundColor: "#ffffff",
                        scrollX: 0,
                        scrollY: 0
                    },
                    jsPDF: {
                        unit: "mm",
                        format: "a4",
                        orientation: "portrait",
                        compress: true
                    },
                    pagebreak: {
                        mode: ["css"],
                        avoid: ["tr", ".sign-row", ".personal-two-col", ".two-col"]
                    }
                };

                var fontsReady = document.fonts && document.fonts.ready
                    ? document.fonts.ready
                    : Promise.resolve();

                fontsReady
                    .then(function () {
                        return html2pdf().set(opt).from(printArea).save();
                    })
                    .catch(function () {
                        alert("PDF তৈরি করা যায়নি। প্রিন্ট করুন ব্যবহার করে Save as PDF করুন।");
                    })
                    .then(function () {
                        document.body.classList.remove("pdf-mode");
                        btnPdf.disabled = false;
                        label.textContent = original;
                    });
            });
        }());
    </script>
</body>
</html>
