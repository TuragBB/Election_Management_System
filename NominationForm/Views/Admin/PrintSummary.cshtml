@model NominationSystem.Models.NominationPage
@using NominationSystem.Models

@{
    Layout = null;
    int n = 0;
}

<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>মনোনয়ন আবেদন সামারি</title>
    <link href="@Url.Content("~/Content/admin-print.css")" rel="stylesheet" />
    <style>
        .paper.wide {
            max-width: 1120px;
        }
    </style>
</head>
<body class="summary-body">
    <div class="print-toolbar no-print">
        <button type="button" id="btnPrint" class="pt-btn primary">প্রিন্ট করুন</button>
        <button type="button" id="btnClose" class="pt-btn">বন্ধ করুন</button>
    </div>

    <div class="paper wide">
        <div class="form-header">
            <div class="fh-org">Staff Welfare Fund</div>
            <h1>মনোনয়ন আবেদনের সামারি তালিকা</h1>
            <h3>ত্রিবার্ষিক নির্বাচন–২০২৭</h3>
            <div class="fh-meta">
                <span>ফিল্টার: <strong>@ViewBag.FilterText</strong></span>
                <span>মোট: <strong>@Bn.Digits(Model.Total) টি</strong></span>
                <span>প্রিন্টের তারিখ: <strong>@Bn.DateTimeText(DateTime.Now)</strong></span>
            </div>
        </div>

        <table class="grid">
            <thead>
                <tr>
                    <th style="width:42px">ক্রমিক</th>
                    <th>আবেদন নং ও তারিখ</th>
                    <th>প্রার্থী</th>
                    <th>সদস্য নং</th>
                    <th>সংস্থার তথ্য</th>
                    <th>যোগাযোগ</th>
                    <th>প্রার্থিতার পদ</th>
                    <th>স্ট্যাটাস</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.Items)
                {
                    n++;
                    <tr>
                        <td>@Bn.Digits(n)</td>
                        <td>@x.ApplicationNo<br />@Bn.DateText(x.ApplicationDate)</td>
                        <td><strong>@x.CandidateName</strong></td>
                        <td>@x.MemberNo</td>
                        <td>@x.Designation<br />আইডি: @x.OrganizationId</td>
                        <td>@x.Mobile<br />@x.Email</td>
                        <td>@x.DesiredPost</td>
                        <td>@NominationStatus.Text(x.Status)</td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="8" style="text-align:center;padding:20px">কোনো আবেদন পাওয়া যায়নি।</td></tr>
                }
            </tbody>
        </table>
    </div>

    <script>document.getElementById('btnPrint').addEventListener('click', function () { window.print(); });
        document.getElementById('btnClose').addEventListener('click', function () { window.close(); });</script>
</body>
</html>
