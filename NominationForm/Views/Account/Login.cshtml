@model NominationSystem.Models.LoginViewModel

@{
    ViewBag.Title = "লগইন";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";

    string notice = Convert.ToString(TempData["AuthMsg"]);
}

<div class="acc-head">
    <span class="acc-head-icon">@VoteIcons.Get("lock", 22)</span>
    <h1>লগইন করুন</h1>
    <p>ভোট দিতে বা মনোনয়ন ফরম পূরণ করতে আপনার অ্যাকাউন্টে প্রবেশ করুন।</p>
</div>

@if (!string.IsNullOrEmpty(notice))
{
    <div class="a-alert">@notice</div>
}

@using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "loginForm", @class = "acc-form", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ReturnUrl)
    @Html.ValidationSummary(true, "", new { @class = "a-alert" })

    <div class="a-field">
        <label for="Login">ই-মেইল অথবা মোবাইল নম্বর</label>
        @Html.TextBoxFor(m => m.Login, new { @class = "a-input", autocomplete = "username", placeholder = "example@mail.com অথবা ০১৭XXXXXXXX", autofocus = "autofocus" })
        @Html.ValidationMessageFor(m => m.Login, "", new { @class = "a-err" })
    </div>

    <div class="a-field">
        <label for="Password">পাসওয়ার্ড</label>
        <div class="a-pw">
            @Html.PasswordFor(m => m.Password, new { @class = "a-input", autocomplete = "current-password", placeholder = "আপনার পাসওয়ার্ড" })
            <button type="button" class="a-pw-toggle" data-toggle-pw="Password" aria-label="পাসওয়ার্ড দেখান বা লুকান">দেখান</button>
        </div>
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "a-err" })
    </div>

    <label class="a-check">
        @Html.CheckBoxFor(m => m.RememberMe)
        <span>এই ডিভাইসে আমাকে মনে রাখুন (১৪ দিন)</span>
    </label>

    <button type="submit" class="a-btn a-btn-primary" data-busy="প্রবেশ করা হচ্ছে...">লগইন করুন</button>
}

@if (GoogleOAuth.IsConfigured)
{
    <div class="a-or"><span>অথবা</span></div>

    <a class="a-btn a-btn-google" href="@Url.Action("GoogleLogin", "Account", new { returnUrl = Model.ReturnUrl })">
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z" />
            <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.7c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4.1 7.1-10.1 7.1-17z" />
            <path fill="#FBBC05" d="M10.5 28.7c-.5-1.5-.8-3-.8-4.7s.3-3.2.8-4.7l-7.9-6.1C.9 16.4 0 20.1 0 24s.9 7.6 2.6 10.8l7.9-6.1z" />
            <path fill="#34A853" d="M24 48c6.500 0 11.900-2.100 15.900-5.800l-7.500-5.800c-2.100 1.400-4.800 2.300-8.400 2.300-6.300 0-11.600-4.100-13.500-9.800l-7.900 6.100C6.500 42.600 14.600 48 24 48z" />
        </svg>
        <span>Google দিয়ে লগইন</span>
    </a>
}

<p class="a-switch">
    নতুন ব্যবহারকারী?
    <a href="@Url.Action("Register", "Account", new { returnUrl = Model.ReturnUrl })">অ্যাকাউন্ট খুলুন</a>
</p>
