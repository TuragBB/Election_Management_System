<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Staff Welfare Fund</title>
    @Styles.Render("~/Content/css")
    <link href="@Url.Content("~/Content/nomination.css")" rel="stylesheet" />
    @RenderSection("styles", required: false)
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <header class="site-header">
        <div class="site-header-inner">
            <a class="brand" href="@Url.Action("Index", "Nomination")">
                <span class="brand-mark">SWF</span>
                <span class="brand-text">
                    <strong>Staff Welfare Fund</strong>
                    <small>অনলাইন মনোনয়ন পোর্টাল</small>
                </span>
            </a>
            <span class="header-tag">ত্রিবার্ষিক নির্বাচন–২০২৭</span>
        </div>
    </header>

    <main class="app-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        © ২০২৬–২০২৭ Staff Welfare Fund | নির্বাচন পরিচালনা পরিষদ কর্তৃক সর্বস্ব সংরক্ষিত।
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
