@{
    string ctrl = Convert.ToString(ViewContext.RouteData.Values["controller"]);

    // ফাইল বদলালেই URL বদলায়, তাই ব্রাউজার পুরোনো CSS cache করে রাখে না
    string nomCss = Url.Content("~/Content/nomination.css") + "?v=" +
        System.IO.File.GetLastWriteTime(Server.MapPath("~/Content/nomination.css")).Ticks;
}
<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Staff Welfare Fund</title>
    @Styles.Render("~/Content/css")
    <link href="@nomCss" rel="stylesheet" />
    @RenderSection("styles", required: false)
    @Scripts.Render("~/bundles/modernizr")
    <link href="@Url.Content("~/Content/account.css")" rel="stylesheet" />
</head>
<body>
    <header class="site-header">
        <div class="site-header-inner">
            <a class="brand" href="@Url.Action("Index", "Nomination")">
                <span class="brand-mark">SWF</span>
                <span class="brand-text">
                    <strong>Staff Welfare Fund</strong>
                    <small>অনলাইন মনোনয়ন ও ভোটিং পোর্টাল</small>
                </span>
            </a>

            <nav class="site-nav" aria-label="প্রধান মেনু">
                <a href="@Url.Action("Index", "Nomination")" class="@(ctrl == "Nomination" ? "active" : "")">মনোনয়ন ফরম</a>
                <a href="@Url.Action("Index", "Vote")" class="@(ctrl == "Vote" ? "active" : "")">অনলাইন ভোটিং</a>
            </nav>

            @Html.Partial("_AuthBox")

            <span class="header-tag">ত্রিবার্ষিক নির্বাচন–২০২৭</span>
        </div>
    </header>

    <main class="app-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        © ২০২৬–২০২৭ Staff Welfare Fund | নির্বাচন পরিচালনা পরিষদ কর্তৃক সর্বস্ব সংরক্ষিত।
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>