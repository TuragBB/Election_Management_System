@{
    string active = Convert.ToString(ViewBag.Active);
    string pageTitle = Convert.ToString(ViewBag.PageTitle);
}
<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - Staff Welfare Fund</title>
    <link href="@Url.Content("~/Content/admin.css")" rel="stylesheet" />
    @RenderSection("styles", required: false)
</head>
<body>
    <div class="admin-shell">

        <!-- ================= Sidebar ================= -->
        <aside class="sidebar" id="sidebar">
            <div class="sb-brand">
                <span class="sb-logo">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 10l9-6 9 6" />
                        <path d="M5 10v8M9.5 10v8M14.5 10v8M19 10v8" />
                        <path d="M3 21h18" />
                    </svg>
                </span>
                <span class="sb-brand-text">Staff Welfare Fund</span>
            </div>

            <nav class="sb-nav">
                <a class="sb-link @(active == "dashboard" ? "active" : "")" href="@Url.Action("Dashboard", "Admin")">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" rx="1" />
                        <rect x="14" y="3" width="7" height="7" rx="1" />
                        <rect x="3" y="14" width="7" height="7" rx="1" />
                        <rect x="14" y="14" width="7" height="7" rx="1" />
                    </svg>
                    <span>ড্যাশবোর্ড</span>
                </a>

                <a class="sb-link @(active == "nominations" ? "active" : "")" href="@Url.Action("Nominations", "Admin")">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                        <path d="M14 3v5h5" />
                        <path d="M9 13h6M9 17h6" />
                    </svg>
                    <span>সকল মনোনয়ন আবেদন</span>
                </a>
            </nav>

            <div class="sb-user">
                <span class="sb-avatar">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z" />
                    </svg>
                </span>
                <span class="sb-user-text">
                    <strong>এডমিন প্যানেল</strong>
                    <small>Super Admin</small>
                </span>
                <a class="sb-logout" href="#" title="লগআউট" onclick="return false;">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <path d="M16 17l5-5-5-5" />
                        <path d="M21 12H9" />
                    </svg>
                </a>
            </div>
        </aside>
        <div class="sb-backdrop" id="sbBackdrop"></div>

        <!-- ================= Main ================= -->
        <div class="main">
            <header class="topbar">
                <button type="button" class="menu-toggle" id="menuToggle" aria-label="মেনু">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <h2 class="topbar-title">@pageTitle</h2>
                <span class="topbar-user" title="Super Admin">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </span>
            </header>

            <div class="content @ViewBag.AdminContentClass">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>(function () {
            var sb = document.getElementById('sidebar');
            var bd = document.getElementById('sbBackdrop');
            var btn = document.getElementById('menuToggle');
            function toggle(open) {
                sb.classList.toggle('open', open);
                bd.classList.toggle('show', open);
            }
            btn.addEventListener('click', function () { toggle(!sb.classList.contains('open')); });
            bd.addEventListener('click', function () { toggle(false); });
        })();</script>
    @RenderSection("scripts", required: false)
</body>
</html>
